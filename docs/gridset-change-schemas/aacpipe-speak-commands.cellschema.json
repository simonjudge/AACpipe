{
  "type": "gridset-cell-changer-schema",
  "version": 1,
  "name": "AACpipe Speak Commands",
  "description": "Adds commands to cells where the whole sentence is spoken i.e.  Speak and Enter.",
  "changes": [
    {
      "tool": "add-commands",
      "criteria": {
        "commandIds": [
          "Action.Speak",
          "Action.Enter"
        ],
        "contentTypes": [
          "Workspace/Chat"
        ],
        "insertedText": "",
        "caption": "",
        "includeGrids": "",
        "excludeGrids": ""
      },
      "commands": "<Command ID=\"Action.Copy\"/>\n<Command ID=\"ComputerControl.Run\">\n<Parameter Key=\"FileName\">%PROFILE%\\AppData\\Local\\Programs\\AACpipe\\aacpipe-bridge.exe</Parameter>\n<Parameter Key=\"Arguments\">--sentence --speak</Parameter>\n<Parameter Key=\"AllowSwitchTo\">1</Parameter>\n<Parameter Key=\"RunCommandType\">Program</Parameter>\n</Command>",
      "position": "end",
      "skipExisting": true
    }
  ]
}
