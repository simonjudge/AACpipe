{
  "name": "aacpipe",
  "version": "0.1.0-preview.1",
  "author": "Simon Judge",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simonjudge/AACpipe.git"
  },
  "private": true,
  "type": "module",
  "main": "dist/apps/publisher/src/main/electron-main.cjs",
  "description": "AACpipe local partner screen application",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "native:build": "node scripts/build-native.mjs",
    "ocr:build": "powershell -NoProfile -File scripts\\build-ocr.ps1",
    "ocr:test": "dotnet run --project apps\\ocr\\tests\\AACpipe.Ocr.Tests.csproj --configuration Release -- release\\aacpipe-ocr\\tessdata",
    "subscriber:build": "node scripts/build-subscriber.mjs",
    "premvp": "npm run native:build && npm run subscriber:build",
    "mvp": "tsx apps/publisher/src/main/mvp-dev.ts",
    "publisher:bundle": "node scripts/build-publisher.mjs",
    "prepublisher:stub": "npm run native:build",
    "publisher:stub": "tsx apps/publisher/src/main/stub.ts",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check \"**/*.{js,mjs,json,ts,yml}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vertical-slice": "vitest run apps/publisher/src/main/vertical-slice.test.ts",
    "test:e2e": "npm run test:vertical-slice",
    "assets:build": "node scripts/build-icons.mjs",
    "notices:build": "node scripts/build-notices.mjs",
    "package": "npm run build && npm run assets:build && npm run subscriber:build && npm run native:build -- --release && node scripts/build-bridge.mjs && npm run publisher:bundle && npm run notices:build && electron-builder --win nsis && node scripts/checksum-release.mjs",
    "test:package": "node scripts/smoke-package.mjs",
    "rust:fmt": "cargo fmt --all --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "@resvg/resvg-js": "^2.6.2",
    "png-to-ico": "^3.0.2",
    "playwright-core": "^1.56.1",
    "electron": "^44.9.3",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^5.0.5",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "org.aacpipe.publisher",
    "productName": "AACpipe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/apps/publisher/src/main/electron-main.cjs",
      "dist/apps/publisher/native/aacpipe_win32_native.node",
      "apps/subscriber/public/**/*",
      "apps/subscriber/dist/subscriber.js",
      "apps/subscriber/dist/manage.js",
      "build/icon.png",
      "LICENSE",
      "dist/THIRD-PARTY-NOTICES.txt",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/apps/publisher/native/**"
    ],
    "extraFiles": [
      {
        "from": "target/release/aacpipe-bridge.exe",
        "to": "aacpipe-bridge.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AACpipe",
      "include": "build/installer.nsh"
    }
  }
}
