{
  "name": "aacpipe",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AACpipe local partner screen application",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "native:build": "node scripts/build-native.mjs",
    "publisher:stub": "tsx apps/publisher/src/main/stub.ts",
    "clean": "node scripts/clean.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check \"**/*.{js,mjs,json,ts,yml}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "echo \"E2E tests are not implemented until Milestone 6\"",
    "package": "echo \"Packaging is not implemented until Milestone 9\"",
    "rust:fmt": "cargo fmt --all --check",
    "rust:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "rust:test": "cargo test --workspace"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "fast-check": "^4.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "tsx": "^4.20.6",
    "vitest": "^2.1.8"
  }
}
